# ============================================================
# KubeJobs Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=supersecret123
REDIS_POOL_SIZE=100
REDIS_MIN_IDLE=20

# App mode: "api" or "worker"
APP_MODE=api

# Worker config (only used when APP_MODE=worker)
WORKER_ID=worker-local
WORKER_CONCURRENCY=5

# Job queue config
MAX_RETRY=3
MAX_QUEUE_SIZE=1000
RECOVERY_TIMEOUT=40
